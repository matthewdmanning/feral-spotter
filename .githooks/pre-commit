#!/bin/sh
# Check staged files before they're committed (lint-staged style) — no base
# branch needed, so unlike the pre-push check this actually runs locally every
# time. It fails on flipped line endings, then formats with the prettier
# version CI uses. See scripts/format-staged.mjs.
#
# Enable once per clone:  git config core.hooksPath .githooks

node scripts/format-staged.mjs || exit 1
