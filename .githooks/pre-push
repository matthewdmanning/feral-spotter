#!/bin/sh
# Gradual prettier — format the files this branch changed before they're pushed.
# If prettier rewrites anything, the push is blocked so you commit the result
# first (a pre-push hook can't amend commits already being pushed).
#
# Base branch defaults to origin/main; PRETTIER_BASE overrides it. See
# scripts/format-changed.mjs for why local base-branch guessing was dropped.
#
# --fail-on-change makes the script itself decide whether prettier rewrote
# anything, scoped to the files it was given. Do not reinstate a bare
# `git diff --quiet` check here: it fires on any dirty file in the tree and
# blocks pushes over edits prettier never touched.
#
# Enable once per clone:  git config core.hooksPath .githooks

node scripts/format-changed.mjs --fail-on-change || exit 1

# Lint every commit this branch adds, over the same range CI lints. The
# commit-msg hook only sees commits made with `git commit`; subtree imports,
# merges, reverts and commits made in another repo skip it.
CLI=node_modules/@commitlint/cli/cli.js
[ -f "$CLI" ] || CLI="$(git rev-parse --git-common-dir)/../node_modules/@commitlint/cli/cli.js"
node "$CLI" --from origin/main --to HEAD || exit 1
