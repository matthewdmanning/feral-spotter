#!/bin/sh
# Local commitlint enforcement — same commitlint.config.js the CI
# commitlint Action checks, run before the commit lands instead of after
# it's pushed (a bad subject caught only in CI needs a force-push to fix).
#
# Wired automatically by `npm install` (the "prepare" script sets
# core.hooksPath). Manual fallback: git config core.hooksPath .githooks

npx commitlint --edit "$1"
