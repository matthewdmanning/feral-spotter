rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // submissions/{uid}/{submissionId}/{fileName}
    match /submissions/{uid}/{submissionId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|heic|heif)')
                   // No counter doc yet == first photo for this submission, allow it;
                   // the Cloud Function creates the doc after the write lands.
                   && (
                     !firestore.exists(/databases/(default)/documents/submissions/$(submissionId))
                     // 10 must match MAX_PHOTOS: src/config/constants.ts (client) and
                     // the duplicate in src/app/upload+api.ts (server) — rules can't read it.
                     || firestore.get(/databases/(default)/documents/submissions/$(submissionId)).data.photoCount < 10
                   );
    }
  }
}
