rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // submissions/{uidHash}/{submissionId}/{fileName} — uidHash is
    // sha256(salt + auth uid), recomputed here rather than trusted from the
    // path segment. Salt literal must match USER_ID_HASH_SALT in
    // src/config/constants.ts exactly (see docs/adr/0005). Confirmed to
    // compile via firebase_validate_security_rules; hashing.sha256(...)
    // .toHexString()'s exact byte-for-byte agreement with expo-crypto's
    // digestStringAsync(SHA256, ...) output can't be confirmed further —
    // this rules suite can't run against the emulator locally (JDK 17 vs
    // firebase-tools' JDK 21 requirement).
    match /submissions/{uidHash}/{submissionId}/{fileName} {
      allow read: if request.auth != null && isOwner(uidHash);

      allow write: if request.auth != null
                   // #267: gate direct-Storage uploads on the tester
                   // allowlist, same cohort upload+api.ts restricts to.
                   // Claim is set by functions/src/index.ts's
                   // gateTesterAllowlist blocking function on sign-in —
                   // costs zero Firestore reads here, keeping the 2-read
                   // budget below free for isValidPhotoWrite/
                   // isValidMetadataWrite's own firestore.get() calls.
                   && request.auth.token.allowedTester == true
                   && isOwner(uidHash)
                   && (
                     (fileName == 'metadata.json' && isValidMetadataWrite())
                     || (fileName != 'metadata.json' && isValidPhotoWrite())
                   );

      function isOwner(hash) {
        return hash == hashing.sha256('feralspotter-photo-metadata-uid-v1' + request.auth.uid).toHexString();
      }

      // Final submission (cats + submission metadata), one small JSON blob
      // per submission — not photo-count gated, it's not a photo.
      function isValidMetadataWrite() {
        return request.resource.size < 256 * 1024
               // Not exact equality — native uploadString() may send
               // 'application/json; charset=utf-8', which exact match denies.
               && request.resource.contentType.matches('application/json(;.*)?')
               && (
                 // #270: caps distinct submissions per uidHash (counted by
                 // functions/src/index.ts's onSubmissionSubmitted at
                 // metadata.json write, not per-photo — isValidPhotoWrite
                 // already spends this rule evaluation's 2-Firestore-read
                 // budget on photoCount; this write gets its own fresh
                 // budget). MAX_SUBMISSIONS_PER_UID in
                 // src/config/constants.ts documents the same number —
                 // rules can't read it.
                 !firestore.exists(/databases/(default)/documents/submissionCounts/$(uidHash))
                 || firestore.get(/databases/(default)/documents/submissionCounts/$(uidHash)).data.count < 50
               );
      }

      function isValidPhotoWrite() {
        let docExists = firestore.exists(/databases/(default)/documents/submissions/$(submissionId));
        let doc = firestore.get(/databases/(default)/documents/submissions/$(submissionId));
        return (
                 // #264: finalizeSubmissionPhotoMetadata patches an already-
                 // uploaded, already-counted photo's customMetadata at Submit
                 // (location/time/upload-time/user-id-hash) — same bytes, not
                 // a new photo. Short-circuits ahead of the size/contentType
                 // checks below, not nested inside them — those describe a
                 // fresh image upload and shouldn't gate a metadata-only
                 // patch even if it doesn't echo them back identically.
                 // size-only check, not md5Hash — that field's exact casing
                 // in the rules resource schema (vs the client SDK's
                 // FullMetadata.md5Hash) is unverified and this rules suite
                 // can't run locally (JDK 17 vs firebase-tools' JDK 21
                 // requirement) to confirm it.
                 (resource != null && resource.size == request.resource.size)
               )
               || (
                 // #269: create-only. A same-fileName overwrite with
                 // different bytes falls through here (it isn't the
                 // same-size patch above) — without resource == null it
                 // would re-fire onObjectFinalized and double-count a photo
                 // that already exists, drifting photoCount out of sync
                 // with the real object count.
                 resource == null
                 && request.resource.size < 20 * 1024 * 1024
                 && request.resource.contentType.matches('image/(jpeg|png|heic|heif)')
                 && (
                   // No counter doc yet == first photo for this submission,
                   // allow it; the Cloud Function creates the doc after the
                   // write lands.
                   !docExists
                   // #268: submissionId is client-generated, so two
                   // different uids can collide on the same id. Once a
                   // counter doc exists, only the uidHash it belongs to may
                   // keep writing photos against it — a collision must fail
                   // closed (denied write) rather than merge into someone
                   // else's submission.
                   // 10 must match MAX_PHOTOS: src/config/constants.ts (client) and
                   // the duplicate in src/app/upload+api.ts (server) — rules can't read it.
                   || (doc.data.ownerUidHash == uidHash && doc.data.photoCount < 10)
                 )
               );
      }
    }
  }
}
