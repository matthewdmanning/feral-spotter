rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // submissions/{uid}/{submissionId}/{fileName} — uid is the requester's
    // own Firebase Auth uid, checked directly against the path segment
    // (was a salted SHA-256 of it, dropped 2026-08-16 — product decision,
    // not a bug fix: a Firebase Auth uid is already opaque/third-party-
    // issued, so hashing added no privacy benefit, and the raw uid is
    // useful for locating a user's objects later. Separately, real-device
    // `storage/unauthorized` denials were confirmed caused by the tester-
    // allowlist Cloud Function never being deployed, not by the hash;
    // whether the hash's rules-side `hashing.sha256()` actually matched
    // the client's SHA-256 byte-for-byte was never confirmed either way —
    // this local emulator's implementation of that function was found to
    // diverge from the standard algorithm, so it couldn't settle the
    // question — but a plain uid has no such cross-language agreement to
    // get wrong regardless).
    match /submissions/{uid}/{submissionId}/{fileName} {
      allow read: if request.auth != null && isOwner(uid);

      // Deliberately `create, update` rather than `write` (#293): `write`
      // also covers delete, and on a delete `request.resource` is null, so
      // both validators below dereference a null and error out — which
      // fails closed. Every client delete was therefore denied, including
      // the best-effort cleanup discardDraft() now attempts.
      allow create, update: if request.auth != null
                   && isOwner(uid)
                   && (
                     (fileName == 'metadata.json' && isValidMetadataWrite())
                     || (fileName != 'metadata.json' && isValidPhotoWrite())
                   );

      // #293 ("no metadata ⇒ no photo"): owners may delete their own
      // objects. No validator call here on purpose — the write validators
      // describe an incoming `request.resource` that a delete does not
      // have. Ownership is the whole check; the path segment already scopes
      // it to this user's own prefix.
      //
      // This is the client's best-effort half only. The scheduled sweep in
      // functions/ runs under the Admin SDK and bypasses rules entirely, so
      // it is unaffected by this branch — it exists because the client
      // cannot honor the policy alone (offline Reset, force-quit, or a user
      // who simply walks away never issues a delete).
      allow delete: if request.auth != null && isOwner(uid);

      function isOwner(uid) {
        return uid == request.auth.uid;
      }

      // Final submission (cats + submission metadata), one small JSON blob
      // per submission.
      function isValidMetadataWrite() {
        return request.resource.size < 256 * 1024
               // Not exact equality — native uploadString() may send
               // 'application/json; charset=utf-8', which exact match denies.
               && request.resource.contentType.matches('application/json(;.*)?')
               && (
                 // A metadata.json already in place is already counted: a
                 // retry of that Submission is never blocked by the cap.
                 resource != null
                 // #270: functions/ sets this claim once the uid has 250
                 // Submissions (metadata.json objects). No database: the
                 // count lives in Storage, the flag in the Auth token.
                 || request.auth.token.get('submissionCapReached', false) != true
               );
      }

      // A user_id in an object's customMetadata must name the path's owner:
      // the downstream export reads it, so it must not be forgeable.
      function hasOwnUserId(uid) {
        return request.resource.metadata == null
               || !('user_id' in request.resource.metadata)
               || request.resource.metadata.user_id == uid;
      }

      // The 10-photo cap (MAX_PHOTOS in src/config/constants.ts), enforced
      // by name: a Submission's photos can only be photo-0 … photo-9, so
      // no Submission can hold an eleventh. Exact and synchronous; no
      // counter. Overwriting a slot is allowed: it replaces a photo, it
      // does not add one, and it is how Submit patches customMetadata.
      function isValidPhotoWrite() {
        return fileName.matches('photo-[0-9][.](jpg|jpeg|png|heic|heif)')
               && request.resource.size < 20 * 1024 * 1024
               && request.resource.contentType.matches('image/(jpeg|png|heic|heif)')
               && hasOwnUserId(uid);
      }
    }
  }
}
