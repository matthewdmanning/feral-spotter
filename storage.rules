rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // submissions/{uid}/{submissionId}/{fileName} — uid is the requester's
    // own Firebase Auth uid, checked directly against the path segment
    // (was a salted SHA-256 of it, dropped 2026-08-16 — product decision,
    // not a bug fix: a Firebase Auth uid is already opaque/third-party-
    // issued, so hashing added no privacy benefit, and the raw uid is
    // useful for locating a user's objects later. Separately, real-device
    // `storage/unauthorized` denials were confirmed caused by the tester-
    // allowlist Cloud Function never being deployed, not by the hash;
    // whether the hash's rules-side `hashing.sha256()` actually matched
    // the client's SHA-256 byte-for-byte was never confirmed either way —
    // this local emulator's implementation of that function was found to
    // diverge from the standard algorithm, so it couldn't settle the
    // question — but a plain uid has no such cross-language agreement to
    // get wrong regardless).
    match /submissions/{uid}/{submissionId}/{fileName} {
      allow read: if request.auth != null && isOwner(uid);

      // Deliberately `create, update` rather than `write` (#293): `write`
      // also covers delete, and on a delete `request.resource` is null, so
      // both validators below dereference a null and error out — which
      // fails closed. Every client delete was therefore denied, including
      // the best-effort cleanup discardDraft() now attempts.
      allow create, update: if request.auth != null
                   && isOwner(uid)
                   && (
                     (fileName == 'metadata.json' && isValidMetadataWrite())
                     || (fileName != 'metadata.json' && isValidPhotoWrite())
                   );

      // #293 ("no metadata ⇒ no photo"): owners may delete their own
      // objects. No validator call here on purpose — the write validators
      // describe an incoming `request.resource` that a delete does not
      // have. Ownership is the whole check; the path segment already scopes
      // it to this user's own prefix.
      //
      // This is the client's best-effort half only. The scheduled sweep in
      // functions/ runs under the Admin SDK and bypasses rules entirely, so
      // it is unaffected by this branch — it exists because the client
      // cannot honor the policy alone (offline Reset, force-quit, or a user
      // who simply walks away never issues a delete).
      allow delete: if request.auth != null && isOwner(uid);

      function isOwner(uid) {
        return uid == request.auth.uid;
      }

      // Final submission (cats + submission metadata), one small JSON blob
      // per submission — not photo-count gated, it's not a photo.
      function isValidMetadataWrite() {
        return request.resource.size < 256 * 1024
               // Not exact equality — native uploadString() may send
               // 'application/json; charset=utf-8', which exact match denies.
               && request.resource.contentType.matches('application/json(;.*)?')
               && (
                 // #270: caps distinct submissions per uid (counted by
                 // functions/src/index.ts's onSubmissionSubmitted at
                 // metadata.json write, not per-photo — isValidPhotoWrite
                 // already spends this rule evaluation's 2-Firestore-read
                 // budget on photoCount; this write gets its own fresh
                 // budget). MAX_SUBMISSIONS_PER_UID in
                 // src/config/constants.ts documents the same number —
                 // rules can't read it.
                 !firestore.exists(/databases/(default)/documents/submissionCounts/$(uid))
                 || firestore.get(/databases/(default)/documents/submissionCounts/$(uid)).data.count < 250
               );
      }

      function isValidPhotoWrite() {
        let docExists = firestore.exists(/databases/(default)/documents/submissions/$(submissionId));
        let doc = firestore.get(/databases/(default)/documents/submissions/$(submissionId));
        return (
                 // #264: finalizeSubmissionPhotoMetadata patches an already-
                 // uploaded, already-counted photo's customMetadata at Submit
                 // (location/time/upload-time/user id) — same bytes, not
                 // a new photo. Short-circuits ahead of the size/contentType
                 // checks below, not nested inside them — those describe a
                 // fresh image upload and shouldn't gate a metadata-only
                 // patch even if it doesn't echo them back identically.
                 // size-only check, not md5Hash — that field's exact casing
                 // in the rules resource schema (vs the client SDK's
                 // FullMetadata.md5Hash) is unverified. The rules suite CAN
                 // run locally (`npm run test:rules` — needs JDK 21+; this
                 // machine's default is 17, override JAVA_HOME to a newer
                 // JDK if present rather than assuming it's blocked), it
                 // just hasn't been used to confirm this specific field
                 // yet.
                 (resource != null && resource.size == request.resource.size)
               )
               || (
                 // #269: create-only. A same-fileName overwrite with
                 // different bytes falls through here (it isn't the
                 // same-size patch above) — without resource == null it
                 // would re-fire onObjectFinalized and double-count a photo
                 // that already exists, drifting photoCount out of sync
                 // with the real object count.
                 resource == null
                 && request.resource.size < 20 * 1024 * 1024
                 && request.resource.contentType.matches('image/(jpeg|png|heic|heif)')
                 && (
                   // No counter doc yet == first photo for this submission,
                   // allow it; the Cloud Function creates the doc after the
                   // write lands.
                   !docExists
                   // #268: submissionId is client-generated, so two
                   // different uids can collide on the same id. Once a
                   // counter doc exists, only the uid it belongs to may
                   // keep writing photos against it — a collision must fail
                   // closed (denied write) rather than merge into someone
                   // else's submission.
                   // 10 must match MAX_PHOTOS in src/config/constants.ts —
                   // rules can't read it, so keep the two in sync by hand.
                   || (doc.data.ownerUid == uid && doc.data.photoCount < 10)
                 )
               );
      }
    }
  }
}
