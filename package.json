{
  "name": "feral-spotter",
  "main": "expo-router/entry",
  "displayName": "FeralSpotter",
  "author": {
    "name": "Matthew Manning",
    "email": "mattmanningclemson@gmail.com"
  },
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "expo start",
    "preandroid": "adb kill-server && adb start-server && (adb shell pm clear com.mmanning.feralspotter || true)",
    "android": "bash scripts/run-android.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "compat": "npx rn-compatibility-checker ./package.json",
    "lint": "npx expo customize tsconfig.json && expo lint src __tests__",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "jest",
    "test:rules": "node scripts/run-rules-tests.mjs",
    "test:functions": "cd functions && npm test",
    "format": "node scripts/format-changed.mjs",
    "format:check": "node scripts/format-changed.mjs --check",
    "clean-debug": "bash scripts/android-build.sh",
    "device-monitor": "bash scripts/device-monitor.sh",
    "gradle:debug": "expo prebuild --clean && cd android && .\\gradlew assembleDebug"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.1",
    "@posthog/core": "^1.55.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/storage": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.20",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-maps": "~58.0.10",
    "expo-media-library": "~58.0.12",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "phosphor-react-native": "^3.0.6",
    "posthog-react-native": "^4.54.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-liquid-glassmorphism": "1.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.2.5",
    "react-native-vision-camera": "^5.1.0",
    "react-native-worklets": "0.13.0",
    "semver": "^7.8.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/semver": "^7.7.1",
    "@xstate/graph": "^3.0.4",
    "eslint": "^9.9.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^3.6.3",
    "expo-doctor": "~1.19.10",
    "firebase": "^12.17.1",
    "firebase-tools": "^15.26.0",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.4.2",
    "react-test-renderer": "^19.3.0",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3",
    "xstate": "^5.32.5"
  },
  "private": true
}
