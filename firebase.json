{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "FeralSpotter",
        "supportEmail": "mattmanningclemson@gmail.com"
      }
    }
  },
  "storage": {
    "target": "feral-uploads",
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "storage": {
      "port": 9199
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "firestore": {
      "port": 8080
    }
  },
  "react-native": {
    "android_bypass_emulator_url_remap": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
