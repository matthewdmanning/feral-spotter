# Get a key from https://platform.claude.com/ and export it in the shell that
# runs the agent. The Agent SDK reads the key from the process environment and
# does NOT load .env files on its own.
#
#   PowerShell:  $env:ANTHROPIC_API_KEY = "your-api-key"
#   bash/zsh:    export ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_API_KEY=your_api_key_here
