rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // photoCount is maintained only by the Cloud Function storage triggers
    // (functions/src/index.ts), which use the Admin SDK and bypass these
    // rules — clients get read-only access to their own submission.
    // ownerUid is the requester's own Firebase Auth uid, checked directly
    // (was a salted SHA-256 of it, dropped 2026-08-15 — see storage.rules
    // for why).
    match /submissions/{submissionId} {
      allow read: if request.auth != null
                   && request.auth.uid == resource.data.ownerUid;
      allow write: if false;
    }

    // #270: per-uid submission count (functions/src/index.ts's
    // onSubmissionSubmitted), read by storage.rules to cap submissions
    // per uid. The {submissionId} marker subcollection under each doc
    // exists only to dedupe metadata.json retries — clients never need it.
    match /submissionCounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /items/{submissionId} {
        allow read, write: if false;
      }
    }
  }
}
