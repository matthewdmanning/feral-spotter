rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // photoCount is maintained only by the Cloud Function storage triggers
    // (functions/src/index.ts), which use the Admin SDK and bypass these
    // rules — clients get read-only access to their own submission.
    // ownerUidHash is the same sha256(salt + uid) storage.rules uses
    // (docs/adr/0005) — the Cloud Function only ever sees the hashed path
    // segment, never the raw uid, so this field can't hold anything else.
    match /submissions/{submissionId} {
      allow read: if request.auth != null
                   && hashing.sha256('feralspotter-photo-metadata-uid-v1' + request.auth.uid).toHexString()
                      == resource.data.ownerUidHash;
      allow write: if false;
    }

    // #270: per-uid submission count (functions/src/index.ts's
    // onSubmissionSubmitted), read by storage.rules to cap submissions
    // per uidHash. The {submissionId} marker subcollection under each doc
    // exists only to dedupe metadata.json retries — clients never need it.
    match /submissionCounts/{uidHash} {
      allow read: if request.auth != null
                   && hashing.sha256('feralspotter-photo-metadata-uid-v1' + request.auth.uid).toHexString()
                      == uidHash;
      allow write: if false;

      match /items/{submissionId} {
        allow read, write: if false;
      }
    }
  }
}
