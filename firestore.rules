rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // photoCount is maintained only by the Cloud Function storage triggers
    // (functions/src/index.ts), which use the Admin SDK and bypass these
    // rules — clients get read-only access to their own submission.
    match /submissions/{submissionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow write: if false;
    }
  }
}
